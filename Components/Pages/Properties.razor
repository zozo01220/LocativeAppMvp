                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var f in features)
                                {
                                    <div class="form-check">
                                        <input type="checkbox"
                                        class="form-check-input"
                                        checked="@editSelectedFeatures.Contains(f.Id)"
