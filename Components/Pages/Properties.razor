    /// <summary>
    /// Enregistre les modifications apportées à un bien depuis le formulaire d'édition : récupérer le bien en base de données à partir de l'id de editProperty, puis mettre à jour les champs du bien avec les valeurs modifiées dans editProperty. Après la sauvegarde, réinitialiser editProperty à null pour fermer le modal, recharger la liste des biens pour rafraîchir l'affichage, et afficher un message de succès. Cette méthode est appelée lors du clic sur le bouton "Enregistrer" dans le modal d'édition.
    /// </summary>
    /// <returns></returns>
    async Task SaveEditProperty()
    {
        using var db = DbFactory.CreateDbContext();

        var p = await db.Properties
            .Include(x => x.PropertyFeatures)
            .FirstOrDefaultAsync(x => x.Id == editProperty.Id);

        if (p == null) return;

        // champs
        p.ResidentialComplex = editProperty.ResidentialComplex;
        p.Title = editProperty.Title;
        p.Address = editProperty.Address;
        p.PostalCode = editProperty.PostalCode;
        p.City = editProperty.City;
        p.AcquisitionDate = editProperty.AcquisitionDate;
        p.Description = editProperty.Description;
        p.PropertyTypeId = editProperty.PropertyTypeId;
        p.Surface = editProperty.Surface;
        p.IsFurnished = editProperty.IsFurnished;
        p.RentAmount = editProperty.RentAmount;
        p.DepositAmount = editProperty.DepositAmount;
        p.ChargesAmount = editProperty.ChargesAmount;
        p.IsActive = editProperty.IsActive;

        // FEATURES reset + rebuild
        db.PropertyFeatures.RemoveRange(p.PropertyFeatures);

        foreach (var id in editSelectedFeatures)
        {
            db.PropertyFeatures.Add(new PropertyFeature
                {
                    PropertyId = p.Id,
                    FeatureId = id
                });
        }

		// IMAGE enregistrement si nouvelle image sélectionnée
        if (editImageFile != null)
        {
            var ownerId = await CurrentOwnerService.GetOwnerIdAsync();

            var folder = Path.Combine(
                Env.WebRootPath,
                "uploads",
                "Properties");

            Directory.CreateDirectory(folder);

            var fileName = Guid.NewGuid() + Path.GetExtension(editImageFile.Name);
            var filePath = Path.Combine(folder, fileName);

            await using var stream = new FileStream(filePath, FileMode.Create);
            await editImageFile.OpenReadStream(50 * 1024 * 1024).CopyToAsync(stream);

            p.MainPhotoPath = $"/uploads/Properties/{fileName}";
        }

        await db.SaveChangesAsync();

        editProperty = null;
        await Load();
        await ShowMessage("Bien modifié avec succès !");
    }

