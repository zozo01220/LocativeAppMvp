    /// <summary>
    /// Libérer un bien : mettre à null le locataire, réactiver les candidatures, et
    /// désactiver le locataire (inactif tant qu'il n'a pas de bien) et les candidatures
    /// associées à ce locataire
    /// </summary>
    /// <param name="p"></param>
    /// <returns></returns>
    async Task Liberer(Property p)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Libérer ce bien ?");
        if (!confirm) return;

        using var db = DbFactory.CreateDbContext();

        var property = db.Properties
            .FirstOrDefault(x => x.Id == p.Id);

        if (property == null) return;

        // 🔥 1. fermer le contrat actif
        var lease = db.LeaseContracts
            .FirstOrDefault(x => x.PropertyId == property.Id && x.EndDate == null);

        int? tenantId = null;

        if (lease != null)
        {
            lease.EndDate = DateTime.Now;
            tenantId = lease.TenantId;
        }

        // 🔥 2. propriété devient disponible
        property.AcceptingCandidates = true;

        // 🔥 3. désactiver tenant si existant
        if (tenantId != null)
        {
            var tenant = db.Tenants
                .FirstOrDefault(x => x.Id == tenantId);

            if (tenant != null)
            {
                tenant.IsActive = false;
            }

            var candidates = db.Candidates
                .Where(x => x.TenantId == tenantId)
                .ToList();

            foreach (var c in candidates)
            {
                c.TenantId = null;
                c.Status = "Interested";
            }
        }

        await db.SaveChangesAsync();

        await Load();

        await ShowMessage("Le bien a été libéré avec succès !");
    }
    /// <summary>
    /// Retourner le taux d'occupation d'un bien : calculer la durée totale depuis l'acquisition du bien,
    /// </summary>
    /// <param name="p"></param>
    /// <returns></returns>
    double GetOccupancyRate(Property p)
    {
        if (p.AcquisitionDate == null)
            return 0;

        var start = p.AcquisitionDate.Value.Date;
        var end = DateTime.Today;

        var totalDays = (end - start).TotalDays;
        if (totalDays <= 0)
            return 0;

        var leases = p.LeaseContracts ?? new List<LeaseContract>();

        double rentedDays = 0;

        foreach (var lease in leases)
        {
            var leaseStart = lease.StartDate.Date;
            var leaseEnd = lease.EndDate?.Date ?? DateTime.Today;

            // clamp dans la période du bien
            var effectiveStart = leaseStart < start ? start : leaseStart;
            var effectiveEnd = leaseEnd > end ? end : leaseEnd;

            if (effectiveEnd > effectiveStart)
            {
                rentedDays += (effectiveEnd - effectiveStart).TotalDays;
            }
        }

        return Math.Round((rentedDays / totalDays) * 100, 1);
    }
    /// <summary>
    /// Ouvre le modal d'édition d'un bien en copiant les données du bien sélectionné dans
    /// la variable editProperty, qui est utilisée pour lier les champs du formulaire d'édition.
    /// Cette méthode est appelée lors du clic sur l'action "Modifier" dans le menu de chaque
    /// bien, et permet d'afficher le modal avec les informations du bien pré-remplies pour pouvoir
    /// les modifier. La variable editProperty est ensuite utilisée pour enregistrer
    /// les modifications apportées au bien lors de la validation du formulaire d'édition.
    /// </summary>
    /// <param name="p"></param>
    void OpenEditModal(Property p)
    {
        editProperty = new Property
            {
                Id = p.Id,
                ResidentialComplex = p.ResidentialComplex,
                Title = p.Title,
                Address = p.Address,
                PostalCode = p.PostalCode,
                City = p.City,
                AcquisitionDate = p.AcquisitionDate,
                Description = p.Description,
                PropertyTypeId = p.PropertyTypeId,
                Surface = p.Surface,
                IsFurnished = p.IsFurnished,
                RentAmount = p.RentAmount,
                DepositAmount = p.DepositAmount,
                ChargesAmount = p.ChargesAmount,
                IsActive = p.IsActive
            };

        editSelectedFeatures = p.PropertyFeatures?
            .Select(x => x.FeatureId)
            .ToList() ?? new();
    }
