    /// <summary>
    /// Activer/désactiver un bien : si le bien est actuellement actif, le désactiver (mettre IsActive à false), sinon l'activer (mettre IsActive à true) et mettre à jour la date de changement d'état. Si le bien est désactivé alors qu'il était occupé, clôturer le contrat de location actif en mettant sa date de fin à aujourd'hui pour libérer le bien. Après la modification, recharger la liste des biens pour rafraîchir l'affichage. Cette méthode est appelée depuis le menu d'action de chaque bien, après confirmation de l'utilisateur.
    /// </summary>
    /// <param name="id"></param>
    /// <returns></returns>
    async Task ActivInactivProperty(int id)
    {
        using var db = DbFactory.CreateDbContext();

        var p = db.Properties.Find(id);

        if (p != null)
        {
            p.Sold = false;
            p.AcceptingCandidates = false;
            p.ActivInactivDate = DateTime.Now;
            p.IsActive = !p.IsActive;

            // 🔥 on clôture le contrat actif
            var lease = await db.LeaseContracts
                .FirstOrDefaultAsync(l => l.PropertyId == p.Id && l.EndDate == null);

            if (lease != null)
            {
                lease.EndDate = DateTime.Now;
            }

            await db.SaveChangesAsync();
        }

        await Load();

        await ShowMessage("Bien marquer comme vendu avec succès !");
    }
