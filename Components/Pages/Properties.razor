@page "/properties"
@rendermode InteractiveServer

@using LocativeApp.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize]
@attribute [Authorize(Roles = "Admin")]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CurrentOwnerService CurrentOwnerService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment Env

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="mb-4">
        <i class="bi bi-house-door-fill me-2"></i>
        Biens
    </h3>
    <!-- FILTRES -->
    <div class="btn-group mb-0">
        <button class="btn btn-outline-secondary @(tenantFilter == "all" ? "active" : "")"
                @onclick='() => tenantFilter = "all"'>
            Tous
        </button>

        <button class="btn btn-outline-secondary @(tenantFilter == "active" ? "active" : "")"
                @onclick='() => tenantFilter = "active"'>
            Actifs
        </button>

        <button class="btn btn-outline-secondary @(tenantFilter == "inactive" ? "active" : "")"
                @onclick='() => tenantFilter = "inactive"'>
            Inactifs
        </button>
    </div>
</div>


@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success fade-message">@message</div>
}

<!-- FORMULAIRE -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center"
    style="cursor:pointer"
    @onclick="ToggleForm">

        <h6 class="mb-0">➕ Ajouter un bien</h6>
        <span>@(isFormCollapsed ? "▶" : "▼")</span>
    </div>

    @if (!isFormCollapsed)
    {
        <div class="card-body">

            <!-- HEADER -->
            <div class="mb-3">
                <h6 class="fw-bold mb-1">🏢 Informations du bien</h6>
                <div class="text-muted small">Renseignez les détails principaux</div>
            </div>

            <!-- INFORMATIONS -->
            <div class="mb-3">
                <div class="text-uppercase text-muted small fw-semibold mb-2">Informations</div>

                <input class="form-control form-control-sm mb-2"
                placeholder="Résidence"
                @bind="newProperty.ResidentialComplex" />

                <input class="form-control form-control-sm mb-2"
                placeholder="Titre"
                @bind="newProperty.Title" />

                <!-- 🔥 ADRESSE STRUCTURÉE -->
                <div class="mb-2">
                    <div class="text-muted small mb-1">Adresse</div>

                    <input class="form-control form-control-sm mb-2"
                    placeholder="Rue"
                    @bind="newProperty.Address" />

                    <div class="row g-2">
                        <div class="col-4">
                            <input class="form-control form-control-sm"
                            placeholder="Code postal"
                            @bind="newProperty.PostalCode" />
                        </div>

                        <div class="col-8">
                            <input class="form-control form-control-sm"
                            placeholder="Ville"
                            @bind="newProperty.City" />
                        </div>
                    </div>
                    <!-- 🔥 DATE D'ACQUISITION -->
                    <div class="mb-2">
                        <div class="text-muted small mb-1">Acquisition du bien</div>

                        <input class="form-control form-control-sm"
                        type="date"
                        @bind="newProperty.AcquisitionDate"
                        @bind:format="yyyy-MM-dd" />
                    </div>
                </div>

                <textarea class="form-control form-control-sm mb-2"
                placeholder="Description"
                rows="2"
                @bind="newProperty.Description"></textarea>

                <!-- 🔥 TYPE DE BIEN -->
                <select class="form-control form-control-sm mb-2"
                @bind="newProperty.PropertyTypeId">
                    <option value="">Type de bien</option>
                    @foreach (var t in propertyTypes)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>

                <!-- 🔥 SURFACE -->
                <input class="form-control form-control-sm mb-2"
                type="number"
                placeholder="Surface (m²)"
                @bind="newProperty.Surface" />

                <!-- 🔥 MEUBLÉ -->
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input"
                    type="checkbox"
                    @bind="newProperty.IsFurnished" />
                    <label class="form-check-label">
                        🛋️ Meublé
                    </label>
                </div>

                <!-- 🔥 FEATURES -->
                <div class="mb-2">
                    <div class="text-muted small mb-1">Caractéristiques</div>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var f in features)
                        {
                            <div class="form-check">
                                <input type="checkbox"
                                class="form-check-input"
                                checked="@selectedFeatures.Contains(f.Id)"
                                @onchange="e => ToggleFeature(f.Id)" />

                                <label class="form-check-label small">
                                    @f.Name
                                </label>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- FINANCES -->
            <div class="mb-3">
                <div class="text-uppercase text-muted small fw-semibold mb-2">Montant</div>

                <div class="row g-2">
                    <div class="col-4">
                        <input class="form-control form-control-sm"
                        type="number"
                        placeholder="Loyer"
                        @bind="newProperty.RentAmount" />
                    </div>

                    <div class="col-4">
                        <input class="form-control form-control-sm"
                        type="number"
                        placeholder="Caution"
                        @bind="newProperty.DepositAmount" />
                    </div>

                    <div class="col-4">
                        <input class="form-control form-control-sm"
                        type="number"
                        placeholder="Charges"
                        @bind="newProperty.ChargesAmount" />
                    </div>
                </div>
            </div>

            <!-- STATUS -->
            <div class="mb-3">
                <div class="text-uppercase text-muted small fw-semibold mb-2">Statut</div>

                <div class="form-check form-switch">
                    <input class="form-check-input"
                    type="checkbox"
                    @bind="newProperty.IsActive" />
                    <label class="form-check-label">
                        Bien actif
                    </label>
                </div>
            </div>

            <!-- IMAGE -->
            <div class="mb-3">
                <div class="text-uppercase text-muted small fw-semibold mb-2">Photo</div>

                <InputFile OnChange="OnFileSelected"
                class="form-control form-control-sm" />
            </div>

            <!-- ACTION -->
            <button class="btn btn-primary w-100 shadow-sm" @onclick="AddProperty">
                ➕ Ajouter le bien
            </button>

        </div>
    }
</div>

@if (properties == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="row">
        @foreach (var p in GetFilteredProperties())
        {
            var isOccupied = p.LeaseContracts?.Any(l => l.EndDate == null) == true;
            var isFree = !isOccupied && p.Sold == false;
            var isSold = p.Sold == true;
            var activeLease = p.LeaseContracts?
            .FirstOrDefault(l => l.EndDate == null);

            var tenant = activeLease?.Tenant;

            <div class="col-12 col-sm-6 col-lg-4 mb-3">

                <div class="card property-card h-100">

                    <!-- IMAGE -->
                    <div class="position-relative">

                        @if (!string.IsNullOrEmpty(p.MainPhotoPath))
                        {
                            <img src="@p.MainPhotoPath" class="card-img-top property-img" />
                        }
                        else
                        {
                            <div class="property-img placeholder d-flex align-items-center justify-content-center">
                                <span>Pas d'image</span>
                            </div>
                        }

                        <!-- MENU EDITION RAPIDE -->
                        <button class="btn btn-light btn-sm rounded-circle shadow position-absolute"
                        style="bottom:10px; right:10px; width:38px; height:38px;"
                        @onclick="() => OpenEditModal(p)">
                            <i class="bi bi-pencil"></i>
                        </button>

                        <!-- STATUT + CANDIDATURES (bas gauche empilé) -->
                        <div class="position-absolute top-0 start-0 m-2 d-flex flex-column gap-1">
                            @if (p.AcceptingCandidates)
                            {
                                <span class="badge bg-success">
                                    📢 Candidatures ouvertes
                                </span>
                            }

                        </div>

                        <div class="position-absolute bottom-0 start-0 m-2 d-flex flex-column gap-1">

                            @{
                                var activeCandidates = p.CandidateList?
                                .Where(c => c.IsActive)
                                .ToList() ?? new List<Candidate>();
                            }

                            @if (isFree && activeCandidates.Count > 0)
                            {
                                <span class="badge bg-danger">
                                    👥 @activeCandidates.Count
                                </span>
                            }

                        </div>

                        <!-- MENU -->
                        <div class="position-absolute top-0 end-0 m-2 dropdown">
                            <button class="btn btn-light btn-sm rounded-circle shadow-sm"
                            data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots"></i>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>
                                    <button class="dropdown-item" @onclick="() => GoToCandidates(p.Id)">
                                        👥 Candidats
                                    </button>   
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <button class="dropdown-item"
                                    @onclick="() => Liberer(p)">
                                        🔓 Libérer le bien
                                    </button>
                                </li>

                                <li>
                                    <button class="dropdown-item" @onclick="() => ConfirmAccepting(p)">
                                        @(p.AcceptingCandidates ? "⛔ Fermer candidatures" : "📢 Ouvrir candidatures")
                                    </button>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <button class="dropdown-item"
                                    @onclick="() => ConfirmActivInactivProperty(p.Id)">
                                        @(p.IsActive ? "⛔ Désactiver le bien" : "📢 Activer le bien")
                                    </button>
                                </li>

                                <li>
                                    <button class="dropdown-item"
                                    @onclick="() => ConfirmPropertySold(p.Id)">
                                        🤝 Vendu
                                    </button>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <button class="dropdown-item text-danger"
                                    @onclick="() => ConfirmDelete(p.Id)">
                                        🗑️ Supprimer
                                    </button>
                                </li>

                            </ul>
                        </div>

                    </div>

                    <!-- CONTENU -->
                    <div class="card-body p-3">
                        <div class="text-muted mb-1" style="font-size: 0.8rem;">
                            @p.ResidentialComplex
                        </div>

                        <div class="d-flex justify-content-between align-items-start mb-1">

                            <div>
                                <h6 class="mb-1 fw-bold">
                                    @(p.PropertyType?.Name ?? "Non défini") @(p.Surface.HasValue ? p.Surface.Value : 0) m²
                                </h6>

                                @if (p.IsFurnished)
                                {
                                    <span class="badge bg-info">
                                        🛋️ Meublé
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">
                                        🚫 Non meublé
                                    </span>
                                }
                            </div>

                            @if (p.Sold)
                            {
                                <span class="badge bg-dark">Vendu</span>
                            }
                            else if (!(p.LeaseContracts?.Any(l => l.EndDate == null) == true))
                            {
                                <span class="badge bg-success">Libre</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Occupé</span>
                            }
                        </div>
                        <div class="text-muted small mb-2">
                            📍 @p.Address<br />
                            @p.PostalCode @p.City
                        </div>

                        <div class="mb-1 d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">
                                @($"{p.RentAmount:N0} €")
                            </span>

                            @if (tenant != null)
                            {
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    <span class="small fw-semibold text-muted">
                                        Loué par :
                                    </span>

                                    <span class="badge bg-primary">
                                        👤 @tenant.FirstName @tenant.LastName
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- CAUTION + CHARGES -->
                        <div class="text-muted mb-3" style="font-size: 0.8rem;">

                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-semibold">Caution :</span>
                                <span>@($"{p.DepositAmount:N0} €")</span>

                                <span>/</span>

                                <span class="fw-semibold">Charges :</span>
                                <span>@($"{p.ChargesAmount:N0} €")</span>
                            </div>

                        </div>

                        <!-- AFFICHAGE DES FEATURES -->
                        @if (p.PropertyFeatures != null && p.PropertyFeatures.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mb-2">

                                @foreach (var f in p.PropertyFeatures.Select(x => x.Feature))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        @f.Name
                                    </span>
                                }

                            </div>
                        }

                        <!-- TAUX D'OCCUPATION
                        Taux d’occupation = (Durée occupée / Durée totale) ​* 100
                        -->
                        @{
                            var occupancy = GetOccupancyRate(p);
                        }
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Taux d'occupation</span>
                                <span>@occupancy%</span>
                            </div>

                            <div class="progress">
                                <div class="progress-bar
                                        @(occupancy > 70 ? "bg-success" :
                                          occupancy > 30 ? "bg-warning" : "bg-danger")"
                                style="width:@occupancy%">
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        }
    </div>
}

@if (editProperty != null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">✏️ Modifier le bien</h5>
                    <button class="btn-close" @onclick="CloseEditModal"></button>
                </div>

                <div class="modal-body">

                    <!-- HEADER -->
                    <div class="mb-3">
                        <h6 class="fw-bold mb-1">🏢 Informations du bien</h6>
                        <div class="text-muted small">Modification des détails</div>
                    </div>

                    <!-- INFORMATIONS -->
                    <div class="mb-3">
                        <div class="text-uppercase text-muted small fw-semibold mb-2">Informations</div>

                        <input class="form-control form-control-sm mb-2"
                        placeholder="Résidence"
                        @bind="editProperty.ResidentialComplex" />

                        <input class="form-control form-control-sm mb-2"
                        placeholder="Titre"
                        @bind="editProperty.Title" />

                        <div class="mb-2">
                            <div class="text-muted small mb-1">Adresse</div>

                            <input class="form-control form-control-sm mb-2"
                            placeholder="Rue"
                            @bind="editProperty.Address" />

                            <div class="row g-2">
                                <div class="col-4">
                                    <input class="form-control form-control-sm"
                                    placeholder="Code postal"
                                    @bind="editProperty.PostalCode" />
                                </div>

                                <div class="col-8">
                                    <input class="form-control form-control-sm"
                                    placeholder="Ville"
                                    @bind="editProperty.City" />
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="text-muted small mb-1">Acquisition du bien</div>

