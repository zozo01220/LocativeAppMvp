                        <!-- MEUBLÉ -->
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input"
                            type="checkbox"
                            @bind="editProperty.IsFurnished" />
                            <label class="form-check-label">🛋️ Meublé</label>
