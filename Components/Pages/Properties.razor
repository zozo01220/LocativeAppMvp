    /// <summary>
    /// Toggle de la sélection d'une caractéristique dans le formulaire d'ajout de bien : 
    /// si l'id de la caractéristique est déjà présent dans la liste selectedFeatures, 
    /// le retirer (désélectionner), sinon l'ajouter (sélectionner). Cette méthode est 
    /// appelée lors du clic sur une caractéristique dans la liste des caractéristiques 
    /// disponibles dans le formulaire d'ajout de bien. La liste selectedFeatures contient 
    /// les id des caractéristiques sélectionnées, qui seront ensuite associées 
    /// au bien lors de son ajout en base de données.
    /// </summary>
    /// <param name="id"></param>
    void ToggleFeature(int id)
    {
        if (selectedFeatures.Contains(id))
            selectedFeatures.Remove(id);
        else
            selectedFeatures.Add(id);
    }
    /// <summary>
    /// Methode pour charger les biens du propriétaire courant : récupérer l'id du 
    /// propriétaire courant, puis charger les biens associés à ce propriétaire en 
    /// incluant les données du locataire et des candidatures pour pouvoir les afficher 
    /// dans la liste. Si aucun propriétaire n'est connecté, initialiser la liste à vide pour éviter les erreurs d'affichage. Cette méthode est appelée lors de l'initialisation du composant, et après chaque ajout/suppression/modification de bien pour rafraîchir la liste affichée.
    /// </summary>
    /// <returns></returns>
    async Task Load()
    {
        var ownerId = await CurrentOwnerService.GetOwnerIdAsync();
        using var db = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(ownerId))
        {
            properties = new List<Property>();
            return;
        }

        properties = db.Properties
            .Where(p => p.OwnerId == ownerId)
            .Include(p => p.LeaseContracts)
                .ThenInclude(l => l.Tenant)
            .Include(p => p.CandidateList)
            .Include(p => p.PropertyType)
            .Include(p => p.PropertyFeatures)
                .ThenInclude(pf => pf.Feature)
            .AsNoTracking()
            .ToList();

        // charger les types de biens et les caractéristiques pour le
        // formulaire d'ajout de bien
        propertyTypes = db.PropertyTypes.ToList();
        features = db.Features.ToList();
    }
    /// <summary>
    /// Méthode appelée lors de la sélection d'un fichier dans le composant InputFile, 
    /// pour stocker le fichier sélectionné dans la variable selectedFile et 
    /// pouvoir ensuite le sauvegarder lors de l'ajout du bien
    /// </summary>
    /// <param name="e"></param>
    void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }
    /// <summary>
    /// Enregistrer l'image uploadée dans le dossier wwwroot/uploads/properties, et retourner le chemin 
    /// relatif à enregistrer en base de données pour pouvoir afficher l'image ensuite
    /// </summary>
    /// <param name="file"></param>
    /// <returns></returns>
    async Task<string?> SaveImageAsync(IBrowserFile file)
    {
        if (file == null) return null;

        var folder = Path.Combine("wwwroot", "uploads/properties");

        if (!Directory.Exists(folder))
            Directory.CreateDirectory(folder);

        var fileName = Guid.NewGuid() + Path.GetExtension(file.Name);
        var path = Path.Combine(folder, fileName);

        await using var stream = new FileStream(path, FileMode.Create);
        await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(stream);

        return "/uploads/properties/" + fileName;
    }
    /// <summary>
    /// Ajouter un bien : récupérer l'id du propriétaire courant, sauvegarder l'image si elle existe, 
    /// puis ajouter le bien à la base de données et recharger la liste
    /// </summary>
    /// <returns></returns>
    async Task AddProperty()
    {
        var ownerId = await CurrentOwnerService.GetOwnerIdAsync();

        if (selectedFile != null)
        {
            newProperty.MainPhotoPath = await SaveImageAsync(selectedFile);
        }

        if (newProperty.AcquisitionDate == null)
        {
            newProperty.AcquisitionDate = DateTime.Today;
        }

        newProperty.OwnerId = ownerId;

        using var db = DbFactory.CreateDbContext();

        db.Properties.Add(newProperty);

        await db.SaveChangesAsync();

        // Features
        foreach (var featureId in selectedFeatures)
        {
            db.PropertyFeatures.Add(new PropertyFeature
                {
                    PropertyId = newProperty.Id,
                    FeatureId = featureId
                });
        }

        await db.SaveChangesAsync();

        newProperty = new Property();
        selectedFile = null;
        selectedFeatures.Clear();

        await Load();

        await ShowMessage("Nouveau bien ajouté avec succès !");
    }
    /// <summary>
    /// Ajoute des features aux biens
    /// </summary>
    /// <param name="p"></param>
    /// <returns></returns>
    async Task AddFeatureToProperty(Property p)
    {
        if (!newFeatureInput.ContainsKey(p.Id))
            return;

        var name = newFeatureInput[p.Id];

        if (string.IsNullOrWhiteSpace(name))
            return;

        using var db = DbFactory.CreateDbContext();

        var ownerId = await CurrentOwnerService.GetOwnerIdAsync();

        // 🔥 1. vérifier si feature existe déjà
        var normalized = name.Trim().ToLower();

        var feature = await db.Features
            .FirstOrDefaultAsync(f => f.Name.ToLower() == normalized);

        // 🔥 2. si non, créer
        if (feature == null)
        {
            feature = new Feature
                {
                    Name = name
                };

            db.Features.Add(feature);
            await db.SaveChangesAsync();
        }

        // 🔥 3. lier au bien si pas déjà lié
        var exists = await db.PropertyFeatures
            .AnyAsync(x => x.PropertyId == p.Id && x.FeatureId == feature.Id);

        if (!exists)
        {
            db.PropertyFeatures.Add(new PropertyFeature
                {
                    PropertyId = p.Id,
                    FeatureId = feature.Id
                });

            await db.SaveChangesAsync();
        }

        newFeatureInput[p.Id] = "";

        await Load();
    }
