@code {

    List<Property> properties;
    Property newProperty = new Property();
    Property? editProperty;
    List<int> editSelectedFeatures = new();

    private IBrowserFile? editImageFile;
    IBrowserFile? selectedFile;

    private bool isFormCollapsed = true;

    string message = "";


    List<PropertyType> propertyTypes = new();
    List<Feature> features = new();
    List<int> selectedFeatures = new();
    Dictionary<int, string> newFeatureInput = new();

    /// <summary>
    /// Initialisation
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        await Load();
    }
    /// <summary>
    /// Afficher un message temporaire en haut de la page : mettre à jour la variable message, 
    /// appeler StateHasChanged pour rafraîchir l'affichage, puis attendre 3 secondes avant de 
    /// réinitialiser le message et rafraîchir à nouveau l'affichage pour faire disparaître le message. 
    /// Cette méthode peut être utilisée pour afficher des notifications de succès ou d'erreur après 
    /// une action de l'utilisateur (ajout/suppression/modification de bien). Note : il faut ajouter un 
    /// élément dans le markup pour afficher la variable message 
    /// (ex: <div class="alert alert-info">@message</div>), et 
    /// styliser cet élément pour qu'il soit visible et positionné correctement sur la page.
    /// </summary>
    /// <param name="text"></param>
    /// <returns></returns>
    async Task ShowMessage(string text)
    {
        message = text;
        StateHasChanged();

        await Task.Delay(3000);

        message = "";
        StateHasChanged();
    }
    /// <summary>
    /// Indique que le bien est vendu
    /// </summary>
    string tenantFilter = "active";
    bool IsSold(Property p)
    => p.Sold == true && p.SoldDate != null;
    /// <summary>
    /// Indique que le bien est actif : il doit être marqué comme actif, et ne pas être vendu 
    /// (car un bien vendu peut rester actif pour l'historique, mais ne doit pas être 
    /// considéré comme actif pour les filtres et l'affichage). Cette méthode est utilisée
    /// pour filtrer les biens actifs dans la liste, et pour afficher le statut de chaque 
    /// bien dans la carte. Note : un bien vendu peut rester actif pour permettre de 
    /// conserver son historique et ses données, mais il ne sera pas considéré comme 
    /// actif pour les filtres et l'affichage grâce à cette méthode qui vérifie aussi 
    /// le statut de vente du bien.
    /// </summary>
    /// <param name="p"></param>
    /// <returns></returns>
    bool IsActiveProperty(Property p)
        => p.IsActive == true && !IsSold(p);

    /// <summary>
    /// Récupérer le taux d'occupation d'un bien : calculer la durée totale depuis la date d'acquisition du bien (ou une date de référence si l'acquisition est trop ancienne) jusqu'à aujourd'hui, puis calculer la durée totale d'occupation en sommant les périodes d'occupation définies par les contrats de location (en prenant en compte les contrats actifs et passés). Enfin, calculer le taux d'occupation en divisant la durée d'occupation par la durée totale et en multipliant par 100 pour obtenir un pourcentage. Cette méthode est utilisée pour afficher le taux d'occupation de chaque bien dans la carte, et peut être utilisée pour filtrer les biens selon leur taux d'occupation si besoin.
    /// </summary>
    /// <returns></returns>
    IEnumerable<Property> GetFilteredProperties()
    {
        IEnumerable<Property> query = properties;

        if (tenantFilter == "active")
            query = query.Where(p => p.IsActive && !(p.Sold && p.SoldDate != null));

        if (tenantFilter == "inactive")
            query = query.Where(p => !p.IsActive || (p.Sold && p.SoldDate != null));

        return query;
    }
    /// <summary>
    /// Toggle de l'affichage du formulaire d'ajout de bien : si le formulaire est 
    /// actuellement plié, le déplier (afficher), sinon le plier (cacher). Cette méthode 
    /// est appelée lors du clic sur l'en-tête du formulaire "Ajouter un bien". L'état 
    /// du formulaire est géré par la variable booléenne isFormCollapsed, qui est initialisée à 
    /// true (formulaire plié) et inversée à chaque appel de cette méthode pour alterner entre les deux états.
    /// </summary>
    void ToggleForm()
    {
        isFormCollapsed = !isFormCollapsed;
    }
    /// <summary>
    /// Message de confirmation pour l'ouverture/fermeture des candidatures d'un bien
    /// </summary>
    /// <param name="p"></param>
    /// <returns></returns>
    async Task ConfirmAccepting(Property p)
    {
        var action = p.AcceptingCandidates ? "fermer" : "ouvrir";

        var ok = await JS.InvokeAsync<bool>("confirm",
            $"{action.ToUpper()} le bien aux candidats ?");

        if (!ok) return;

        await ToggleAccepting(p);
    }
    /// <summary>
    /// Toggle de l'état d'acceptation des candidatures pour un bien : si le bien acceptait 
    /// les candidatures, le fermer (mettre à false), sinon l'ouvrir (mettre à true) et 
    /// mettre à jour la date de changement d'état. Après la modification, recharger la 
    /// liste des biens pour rafraîchir l'affichage. Cette méthode est appelée depuis le 
    /// menu d'action de chaque bien, après confirmation de l'utilisateur.
    /// </summary>
    /// <param name="p"></param>
    /// <returns></returns>
    async Task ToggleAccepting(Property p)
    {
        using var db = DbFactory.CreateDbContext();

        var property = db.Properties.FirstOrDefault(x => x.Id == p.Id);
        if (property == null) return;

        property.AcceptingCandidates = !property.AcceptingCandidates;
        property.AcceptingCandidatesDate = DateTime.Now;

        await db.SaveChangesAsync();

        await Load();

        if (!p.AcceptingCandidates)
            await ShowMessage("Campagne de candidatures ouverte");
        else await ShowMessage("Campagne de candidatures fermée");
