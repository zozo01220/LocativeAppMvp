<style>
    .fade-message {
        animation: fadeOut 3s forwards;
    }

    @@keyframes fadeOut {
        0% {
            opacity: 1;
        }

        80% {
            opacity: 1;
        }

        100% {
            opacity: 0;
        }
    }

    .bg-orange-dark {
        background-color: #ff8c00 !important;
    }

    .group-header {
        cursor: pointer;
        padding: 10px;
        border-radius: 10px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        user-select: none;
    }

        .group-header:hover {
            background: #eef1f5;
        }
</style>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success fade-message">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (properties == null)
{
    <p>Chargement...</p>
}
else
{

