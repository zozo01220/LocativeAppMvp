@if (showEditModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5)">

        <div class="modal-dialog">
            <div class="modal-content p-3">

                <h5 class="mb-3">✏️ Modifier locataire</h5>

                <input class="form-control mb-2"
                       placeholder="Prénom"
                       @bind="editTenant.FirstName" />

                <input class="form-control mb-2"
                       placeholder="Nom"
                       @bind="editTenant.LastName" />

                <input class="form-control mb-2"
                       placeholder="Email"
                       @bind="editTenant.Email" />

                <input class="form-control mb-2"
                       placeholder="Téléphone"
                       @bind="editTenant.Phone" />

                <div class="row">
                    <div class="col">
                        <label class="small text-muted">Début</label>
                        <input type="date" class="form-control"
                               @bind="editTenant.StartDate" />
                    </div>

                    <div class="col">
                        <label class="small text-muted">Fin</label>
                        <input type="date" class="form-control"
                               @bind="editTenant.EndDate" />
                    </div>
                </div>

                <div class="form-check form-switch mt-2">
                    <input class="form-check-input"
                           type="checkbox"
                           @bind="editTenant.IsActive" />
                    <label class="form-check-label">
                        Actif
                    </label>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">

                    <button class="btn btn-secondary btn-sm"
                            @onclick="() => showEditModal = false">
                        Annuler
                    </button>

                    <button class="btn btn-primary btn-sm"
                            @onclick="SaveTenant">
                        Enregistrer
                    </button>

                </div>

            </div>
        </div>

    </div>
}

@code {

    private enum UploadType
    {
        LeaseAgreement,
        PropertyReport
    }

    private UploadType currentUploadType;

    List<Property> properties;

    string errorMessage = "";
    string successMessage = "";

    bool showSuccessMessage = false;

    DateTime startDate;
    DateTime endDate;

    Dictionary<int, List<RentPayment>> paymentsCache = new();
    Dictionary<int, double> percentCache = new();

    // Filtre de visibilité
    string tenantFilter = "active"; // all - active - inactive
    
    // Plier déplier par défaut
    bool showActive = true;
    bool showInactive = false;

    // Upload fichiers
    private InputFile? fileInputLeaseAgreement;
	private InputFile? fileInputPropertyReport;
	private InputFile? fileInput;
    private ElementReference fileElement;

    private Tenant? selectedTenant;
    private Tenant editTenant = new();
    private bool showEditModal = false;

    protected override async Task OnInitializedAsync()
    {
        await Load();

        var now = DateTime.Now;
        var firstDayLastMonth = new DateTime(now.Year, now.Month, 1).AddMonths(-1);
        startDate = firstDayLastMonth;
        endDate = firstDayLastMonth.AddMonths(1).AddDays(-1);
    }

    async Task Load()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            var ownerId = await CurrentOwnerService.GetOwnerIdAsync();

            properties = await db.Properties
                .Where(c => c.OwnerId == ownerId)
                .Include(p => p.LeaseContracts)
                    .ThenInclude(l => l.Tenant)
                .Include(p => p.PropertyType)   // 🔥 AJOUT IMPORTANT
                .Include(p => p.PropertyFeatures)
                    .ThenInclude(pf => pf.Feature) // 🔥 si tu affiches les features côté UI
                .AsNoTracking()
                .ToListAsync();

            paymentsCache.Clear();
            percentCache.Clear();

            foreach (var p in properties)
            {
                var lease = p.LeaseContracts?
                    .FirstOrDefault(l => l.EndDate == null);

                if (lease?.Tenant == null)
                    continue;

                var tenantId = lease.Tenant.Id;

                var payments = await RentService.GetPaymentsAsync(tenantId);

                var months = payments
                    .Select(x => new DateTime(x.Year, x.Month, 1))
                    .ToList();

                int total = months.Count;
                int paid = payments.Count(x => x.IsPaid);

                paymentsCache[tenantId] = payments;
                percentCache[tenantId] = total == 0 ? 0 : (paid * 100.0 / total);
            }


        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    async Task ShowMessage(string text)
    {
        successMessage = text;
        showSuccessMessage = true;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(3000);

        showSuccessMessage = false;
        successMessage = "";

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenUpload(Tenant tenant, UploadType type)
    {
        selectedTenant = tenant;
        currentUploadType = type;

        await JS.InvokeVoidAsync("triggerFile", fileElement);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || selectedTenant == null) return;

        var ownerId = await CurrentOwnerService.GetOwnerIdAsync();
        var folder = $"{selectedTenant.FirstName}_{selectedTenant.LastName}".Replace(" ", "_");

        var subFolder = currentUploadType switch
        {
            UploadType.LeaseAgreement => "Bail",
            UploadType.PropertyReport => "EtatLieux",
            _ => "Documents"
        };

        var path = Path.Combine(
            Env.WebRootPath,
            "uploads",
            "Tenants",
            ownerId,
            folder,
            "DocumentsCommun",
            subFolder
        );

        Directory.CreateDirectory(path);

        var filePath = Path.Combine(path, file.Name);

        await using var stream = new FileStream(filePath, FileMode.Create);
        await file.OpenReadStream(50 * 1024 * 1024).CopyToAsync(stream);

        await ShowMessage("Upload terminé ✔");
    }

    private async Task HandleFileSelectedLeaseAgreement(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || selectedTenant == null) return;

        var ownerId = await CurrentOwnerService.GetOwnerIdAsync();

        var folder = $"{selectedTenant.FirstName}_{selectedTenant.LastName}".Replace(" ", "_");

        var path = Path.Combine(
            Env.WebRootPath,
            "uploads",
            "Tenants",
            ownerId,
            folder,
            "DocumentsCommun",
            "Bail"
        );

        Directory.CreateDirectory(path);

        var filePath = Path.Combine(path, file.Name);

        await using var stream = new FileStream(filePath, FileMode.Create);
        await file.OpenReadStream(50 * 1024 * 1024).CopyToAsync(stream);

        await ShowMessage("Import du bail terminé ✔");
    }

    private async Task HandleFileSelectedPropertyReport(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || selectedTenant == null) return;

        var ownerId = await CurrentOwnerService.GetOwnerIdAsync();

        var folder = $"{selectedTenant.FirstName}_{selectedTenant.LastName}".Replace(" ", "_");

        var path = Path.Combine(
            Env.WebRootPath,
            "uploads",
            "Tenants",
            ownerId,
            folder,
            "DocumentsCommun",
            "EtatLieux"
        );

        Directory.CreateDirectory(path);

        var filePath = Path.Combine(path, file.Name);

        await using var stream = new FileStream(filePath, FileMode.Create);
        await file.OpenReadStream(50 * 1024 * 1024).CopyToAsync(stream);

        await ShowMessage("Import de l'état des lieux terminé ✔");
    }

    private async Task OpenUploadPropertyReport(Tenant tenant)
    {
        selectedTenant = tenant;

        await JS.InvokeVoidAsync("eval", @"
        document.querySelector('input[type=file]').click();");
    }

    private async Task OpenUploadLeaseAgreement(Tenant tenant)
    {
        selectedTenant = tenant;

        await JS.InvokeVoidAsync("eval", @"
        document.querySelector('input[type=file]').click();");
    }

    List<Property> GetFilteredProperties()
    {
        if (properties == null) return new();

        return tenantFilter switch
        {
            "active" => properties.Where(p =>
            {
                var tenant = p.LeaseContracts?
                    .FirstOrDefault(l => l.EndDate == null)?
                    .Tenant;

                return tenant != null && tenant.IsActive;
            }).ToList(),

            "inactive" => properties.Where(p =>
            {
                var tenant = p.LeaseContracts?
                    .FirstOrDefault(l => l.EndDate == null)?
                    .Tenant;

                return tenant != null && !tenant.IsActive;
            }).ToList(),

            _ => properties.Where(p =>
            {
                var tenant = p.LeaseContracts?
                    .FirstOrDefault(l => l.EndDate == null)?
                    .Tenant;

                return tenant != null;
            }).ToList()
        };
    }

    List<Property> GetFilteredTenants(bool active)
    {
        if (properties == null) return new();

        return properties
            .Where(p =>
            {
                var tenant = p.LeaseContracts?
                    .FirstOrDefault(l => l.EndDate == null)?
                    .Tenant;

                return tenant != null && tenant.IsActive == active;
            })
            .ToList();
    }

    async Task Toggle(Tenant t)
    {
        using var db = DbFactory.CreateDbContext();

        var entity = await db.Tenants.FirstOrDefaultAsync(x => x.Id == t.Id);

        if (entity != null)
        {
            entity.IsActive = !entity.IsActive;
            await db.SaveChangesAsync();
        }

        // 🔥 IMPORTANT : recrée complètement la liste
        var ownerId = await CurrentOwnerService.GetOwnerIdAsync();

        properties = await db.Properties
            .Where(c => c.OwnerId == ownerId)
            .Include(p => p.LeaseContracts).ThenInclude(l => l.Tenant)
            .AsNoTracking()
            .ToListAsync();

        // 🔥 force UI refresh synchronisé Blazor
        await InvokeAsync(StateHasChanged);

        await ShowMessage(entity.IsActive ? "Locataire activé" : "Locataire désactivé");
    }

    string GetPercent(int tenantId)
    {
        return percentCache.TryGetValue(tenantId, out var value)
            ? value.ToString("0")
            : "0";
    }

    int GetPaid(int tenantId)
    {
        return paymentsCache.TryGetValue(tenantId, out var list)
            ? list.Count(x => x.IsPaid)
            : 0;
    }

    int GetUnpaid(int tenantId, DateTime createdAt)
    {
        if (!paymentsCache.TryGetValue(tenantId, out var list))
            return 0;

        return list.Count(x => !x.IsPaid);
    }

    async Task GenerateQuittance(Property p, DateTime period)
    {
        var lease = p.LeaseContracts?
            .FirstOrDefault(l => l.EndDate == null);

        var tenant = lease?.Tenant;

        if (tenant == null)
            return;

        var folderName = $"{tenant.FirstName}_{tenant.LastName}";
        var basePath = Path.Combine(Env.WebRootPath, "uploads", "Candidates", folderName, "Quittances_loyer");

        if (!Directory.Exists(basePath))
            Directory.CreateDirectory(basePath);

        var fileName = $"Quittance_{period:yyyy_MM}.pdf";
        var fullPath = Path.Combine(basePath, fileName);

        var document = Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Margin(30);

                page.Content().Column(col =>
                {
                    col.Item().Text("QUITTANCE DE LOYER").FontSize(20).Bold();
                    col.Item().Text($"Période : {period:MM/yyyy}");
                    col.Item().Text($"Locataire : {tenant.FirstName} {tenant.LastName}");
                    col.Item().Text($"Bien : {p.Title}");
                    col.Item().Text($"Adresse : {p.Address}");
                    col.Item().Text(" ");
                    col.Item().Text($"Loyer : {p.RentAmount}");
                    col.Item().Text($"Charges : {p.ChargesAmount}");
                    col.Item().Text(" ");
                    col.Item().Text("Signature : ____________________");
                });
            });
        });

        document.GeneratePdf(fullPath);
    }

    private void EditTenant(Tenant t)
    {
        editTenant = new Tenant
            {
                Id = t.Id,
                FirstName = t.FirstName,
                LastName = t.LastName,
                Email = t.Email,
                Phone = t.Phone,
                StartDate = t.StartDate,
                EndDate = t.EndDate,
                IsActive = t.IsActive,
                OwnerId = t.OwnerId
            };

        showEditModal = true;
    }

    private async Task SaveTenant()
    {
        using var db = DbFactory.CreateDbContext();

        var entity = await db.Tenants.FirstOrDefaultAsync(x => x.Id == editTenant.Id);

        if (entity == null) return;

        entity.FirstName = editTenant.FirstName;
        entity.LastName = editTenant.LastName;
        entity.Email = editTenant.Email;
        entity.Phone = editTenant.Phone;
        entity.StartDate = editTenant.StartDate;
        entity.EndDate = editTenant.EndDate;
        entity.IsActive = editTenant.IsActive;

        await db.SaveChangesAsync();

        showEditModal = false;

        await Load();

        successMessage = "Locataire modifié avec succès ✔";
    }
}