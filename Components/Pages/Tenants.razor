    {
        <div class="row">

            @foreach (var p in GetFilteredProperties())
            {
                 var activeLease = p.LeaseContracts?
                    .FirstOrDefault(l => l.EndDate == null);

                var tenant = activeLease?.Tenant;

                <div class="col-12 col-sm-6 col-lg-4 mb-3">

                    <div class="card tenant-card h-100 shadow-sm">

                        <div class="position-relative">

                            @if (!string.IsNullOrEmpty(p.MainPhotoPath))
                            {
                                <img src="@p.MainPhotoPath" class="card-img-top tenant-img" />
                            }
