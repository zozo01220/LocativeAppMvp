                                        <i class="bi bi-three-dots"></i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">

                                        <li>
                                            <button class="dropdown-item"
                                                    @onclick="() => Toggle(tenant)">
                                                🔄 Activer / Désactiver
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item"
                                                    @onclick="() => OpenUpload(tenant, UploadType.LeaseAgreement)">
                                                📤 Importer bail
                                            </button>
                                        </li>

                                        <li>
                                            <button class="dropdown-item"
                                                    @onclick="() => OpenUpload(tenant, UploadType.PropertyReport)">
                                                📤 Importer état des lieux
